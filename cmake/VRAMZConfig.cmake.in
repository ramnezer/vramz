@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@VRAMZ_ENABLE_PHYSICAL_RUNTIME@)
    foreach(provider DRIVER CUDART NVCOMP)
        if(NOT VRAMZ_${provider}_LIBRARY OR NOT IS_ABSOLUTE "${VRAMZ_${provider}_LIBRARY}" OR
           NOT EXISTS "${VRAMZ_${provider}_LIBRARY}")
            message(FATAL_ERROR "Set VRAMZ_${provider}_LIBRARY to the explicit externally installed provider file")
        endif()
        if(NOT TARGET VRAMZ_V1_${provider})
            add_library(VRAMZ_V1_${provider} SHARED IMPORTED)
            set_target_properties(VRAMZ_V1_${provider} PROPERTIES IMPORTED_LOCATION "${VRAMZ_${provider}_LIBRARY}")
        endif()
    endforeach()
    if(NOT VRAMZ_LZ4_LIBRARY MATCHES "liblz4\\.a$")
        message(FATAL_ERROR "VRAMZ::cuda requires an explicit static VRAMZ_LZ4_LIBRARY")
    endif()
    file(SHA256 "${VRAMZ_LZ4_LIBRARY}" lz4_sha)
    file(SHA256 "${VRAMZ_LZ4_INCLUDE_DIR}/lz4.h" lz4_header_sha)
    if(NOT lz4_sha STREQUAL "c598b9b376be47052e5c2dd93a6bfbd34329d48b384c05eab9618edb3caf93fb" OR
       NOT lz4_header_sha STREQUAL "c1614ecf7ada7b0be1acb560d4239595f96fbb7aa6a79a7c40cb358753830be6")
        message(FATAL_ERROR "Static LZ4 differs from the validated 1.9.4 provider")
    endif()
endif()
if(@VRAMZ_ENABLE_CPU_LZ4@ AND NOT TARGET VRAMZ_LZ4)
    find_path(VRAMZ_LZ4_INCLUDE_DIR NAMES lz4.h REQUIRED)
    find_library(VRAMZ_LZ4_LIBRARY NAMES lz4 REQUIRED)
    add_library(VRAMZ_LZ4 UNKNOWN IMPORTED)
    set_target_properties(VRAMZ_LZ4 PROPERTIES
        IMPORTED_LOCATION "${VRAMZ_LZ4_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${VRAMZ_LZ4_INCLUDE_DIR}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VRAMZTargets.cmake")
check_required_components(VRAMZ)
